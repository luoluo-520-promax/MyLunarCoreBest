<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{48} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 单元测试中抑制业务层“预期失败”场景的 WARN 堆栈刷屏，测试类自身 INFO 仍输出 -->
    <logger name="cn.itcast.demo.mylunarcore.biz" level="ERROR"/>
    <logger name="cn.itcast.demo.mylunarcore.sys" level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
