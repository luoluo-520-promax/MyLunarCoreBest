<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
    <springProperty scope="context" name="LOG_STRUCTURED" source="logging.structured.enabled" defaultValue="false"/>

    <conversionRule conversionWord="maskMsg"
                    converterClass="cn.itcast.demo.mylunarcore.common.MaskingMessageConverter"/>

    <!-- 文本日志（开发默认）：含脱敏 msg + traceId -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}] %-5level %logger{50} - %maskMsg%n"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}] %-5level %logger{50} - %maskMsg%n"/>
    <!-- 结构化近似 JSON（生产可开 logging.structured.enabled=true 切 profile） -->
    <property name="JSON_PATTERN"
              value='{"ts":"%d{yyyy-MM-dd HH:mm:ss.SSS}","level":"%level","logger":"%logger{50}","traceId":"%X{traceId}","thread":"%thread","msg":"%maskMsg"}%n'/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="SYSTEM_ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/system/system.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/system/system.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <appender name="BUSINESS_ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/business/business.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/business/business.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <appender name="STRUCTURED_ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/structured/app.json.log</file>
        <encoder>
            <pattern>${JSON_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/structured/app.%d{yyyy-MM-dd}.json.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
    </appender>

    <logger name="cn.itcast.demo.mylunarcore.sys" level="INFO" additivity="false">
        <appender-ref ref="SYSTEM_ROLLING"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="STRUCTURED_ROLLING"/>
    </logger>

    <logger name="cn.itcast.demo.mylunarcore.biz" level="INFO" additivity="false">
        <appender-ref ref="BUSINESS_ROLLING"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="STRUCTURED_ROLLING"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="STRUCTURED_ROLLING"/>
    </root>
</configuration>
