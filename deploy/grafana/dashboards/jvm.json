{
  "title": "MyLunarCore JVM & Infra",
  "uid": "mylunarcore-jvm-infra",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "JVM Heap Used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "{{id}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Non-Heap Used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"nonheap\"}", "legendFormat": "{{id}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC Pause (p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(jvm_gc_pause_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(jvm_gc_pause_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process CPU",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "process" },
        { "expr": "system_cpu_usage", "legendFormat": "system" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HikariCP Connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_max", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Netty / Zone Load",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "lunarcore_zone_load_ratio", "legendFormat": "zone_load" },
        { "expr": "lunarcore_online_players", "legendFormat": "online" }
      ]
    },
    {
      "type": "stat",
      "title": "Threads Live",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "targets": [{ "expr": "jvm_threads_live", "legendFormat": "live" }]
    },
    {
      "type": "stat",
      "title": "Zone max-players 参考",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "targets": [{ "expr": "lunarcore_zone_max_players", "legendFormat": "max" }]
    }
  ]
}
